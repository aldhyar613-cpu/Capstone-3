# =============================================================
# .env.example
# Copy file ini → rename jadi .env → isi nilainya
# cp .env.example .env
# =============================================================

# ---------------------------
# OpenAI — WAJIB diisi
# Dapatkan di: https://platform.openai.com/api-keys
# ---------------------------
OPENAI_API_KEY=sk-...

# Model LLM yang dipakai (gpt-4o-mini lebih hemat, gpt-4o lebih akurat)
LLM_MODEL=gpt-4o-mini

# ---------------------------
# Qdrant — vector store untuk semantic search
# Pilih mode: "local" (pakai folder disk) atau "cloud" (Qdrant Cloud)
# ---------------------------
QDRANT_MODE=cloud

# Untuk mode cloud: isi URL dan API key dari dashboard Qdrant
QDRANT_URL=https://xxxx-xxxx.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# Untuk mode local: data disimpan di folder ./qdrant_imdb (otomatis)

# ---------------------------
# MySQL — penyimpanan film & history sesi
# ---------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=imdb_debate

# ---------------------------
# LangGraph Checkpointer
# Path file SQLite untuk menyimpan state graph antar sesi
# Default: debate_history.db di root project
# ---------------------------
LANGGRAPH_DB_PATH=debate_history.db

# ---------------------------
# LangFuse — observability & tracing (opsional)
# Kosongkan jika tidak dipakai
# ---------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
